# badland-brain settings. Copy to .env and edit; every variable is optional unless marked required.
# The server reads its environment only: load this file with `badland-brain --env-file .env serve`,
# `node --env-file=.env dist/cli.js serve`, or Docker Compose (which reads .env itself).

# ---------------------------------------------------------------- server
# Interface and port to listen on (default 127.0.0.1:8270). Keep loopback unless a TLS proxy sits in front.
# BRAIN_PORT=0 picks any free port (the log line names it). Under Docker Compose leave both unset: the image
# listens on 0.0.0.0:8270 inside its container, and docker-compose.yml publishes that on the host's loopback.
# BRAIN_HOST=127.0.0.1
# BRAIN_PORT=8270

# MongoDB connection string: the store of record. The database name in the URI is the brain's.
# Docker Compose ignores this line and points the brain at its own mongo service.
BRAIN_MONGODB_URI=mongodb://127.0.0.1:27017/badland-brain

# Where the SQLite index (brain.sqlite) and the keys file (keys.json) live.
# Default: $XDG_DATA_HOME/badland-brain, else ~/.local/share/badland-brain. The Docker image uses /data.
# BRAIN_DATA_DIR=/var/lib/badland-brain
# Override either file on its own:
# BRAIN_DB_PATH=/var/lib/badland-brain/brain.sqlite
# BRAIN_KEYS_FILE=/etc/badland-brain/keys.json

# Inline key records (JSON: an array, or {"version": 1, "keys": [...]}) accepted beside the keys file, for
# deployments that keep configuration in the environment. Records hold only key hashes; get one from
# `badland-brain keys mint --no-write ...`. An inline set that does not parse stops the server at startup.
# BRAIN_KEYS=[]

# Requests and writes allowed per key per minute (in memory, per process). Over the limit answers 429.
BRAIN_RATE_LIMIT_PER_MINUTE=240
BRAIN_WRITE_RATE_LIMIT_PER_MINUTE=60

# Optional cap on what agent keys may store, history included (unset: unlimited). Owner writes, imports and
# promoted copies never count.
# BRAIN_AGENT_MAX_ENTRIES=5000
# BRAIN_AGENT_MAX_BYTES=26214400

# debug, info, warn, error or silent. Logs are JSON lines on stderr and never carry keys, bodies or queries.
BRAIN_LOG_LEVEL=info

# ---------------------------------------------------------------- embeddings
# gemini (default), openai (any OpenAI-compatible /embeddings endpoint), or fake (deterministic hashing,
# for tests and offline trials only: it has no notion of meaning).
BRAIN_EMBED_PROVIDER=gemini
# Model and vector size. Defaults: gemini-embedding-2 / 1536 for gemini, text-embedding-3-small / 1536 for
# openai, 256 for fake. Changing the model, size, chunking or tokenizer marks the index stale: searches are
# keyword-only until `badland-brain reindex` finishes.
# BRAIN_EMBED_MODEL=gemini-embedding-2
# BRAIN_EMBED_DIMS=1536
# Inputs per embedding request (1-250).
# BRAIN_EMBED_BATCH_SIZE=50

# gemini: the Gemini API key (required for this provider). GOOGLE_API_KEY is read when GEMINI_API_KEY is unset.
GEMINI_API_KEY=
# GOOGLE_API_KEY=

# openai: the API base (default https://api.openai.com/v1; a local server's /v1 works too) and its key.
# A key is required for api.openai.com and optional elsewhere. OPENAI_API_KEY is read when BRAIN_EMBED_API_KEY is unset.
# BRAIN_EMBED_BASE_URL=https://api.openai.com/v1
# BRAIN_EMBED_API_KEY=
# OPENAI_API_KEY=

# ---------------------------------------------------------------- owner commands (import, promote, reindex, ...)
# The running server, and an owner key. The key is read from the environment or a file, never from the command line.
# BRAIN_URL=http://127.0.0.1:8270
# BRAIN_KEY=
# BRAIN_KEY_FILE=/path/to/a/file/holding/the/key

# ---------------------------------------------------------------- importers
# Directories to scan when no --path is given (a PATH-style list: ':' on Linux and macOS).
# BRAIN_IMPORT_PATHS=
# Comma-separated terms a path, working directory or namespace must never contain as a whole word; nothing
# is excluded by default. Every --exclude adds to these.
# BRAIN_IMPORT_EXCLUDE=
# Directories that hold your repositories (PATH-style list), so a path inside one names its repo namespace.
# BRAIN_IMPORT_REPO_ROOTS=
